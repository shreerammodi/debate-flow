{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Core capabilities for the main ebb window.",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "core:window:default",
        "core:webview:default",
        "core:app:default",
        "core:event:default",
        "core:menu:default",
        "updater:default",
        "process:default",
        "dialog:allow-open",
        "dialog:allow-save",
        "opener:allow-reveal-item-in-dir",
        {
            "identifier": "opener:allow-open-url",
            "allow": [
                { "url": "https://ebb.smodi.net/*" },
                { "url": "https://github.com/shreerammodi/ebb*" },
                { "url": "https://smodi.net/*" }
            ]
        }
    ]
}
