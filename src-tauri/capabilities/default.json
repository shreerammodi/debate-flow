{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Core capabilities for every ebb window - each one is a fully independent flow editor or dashboard, so none is more trusted than another.",
    "windows": ["*"],
    "permissions": [
        "core:default",
        "core:window:default",
        "core:webview:default",
        "core:app:default",
        "core:event:default",
        "core:menu:default",
        "updater:default",
        "process:allow-restart",
        "dialog:allow-open",
        "dialog:allow-save",
        "opener:allow-reveal-item-in-dir",
        {
            "identifier": "opener:allow-open-url",
            "comment": "Matched with glob::Pattern against the raw URL string, not URLPattern, so a bare origin needs its own entry: 'https://smodi.net/*' cannot match 'https://smodi.net'.",
            "allow": [
                { "url": "https://ebb.smodi.net/*" },
                { "url": "https://github.com/shreerammodi/ebb*" },
                { "url": "https://smodi.net" },
                { "url": "https://smodi.net/*" }
            ]
        }
    ]
}
